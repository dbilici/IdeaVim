"" ========================================================
"" IdeaVim configuration — single file (~/.ideavimrc)
"" Loaded by all JetBrains IDEs (IntelliJ, PyCharm, WebStorm, ...).
"" ========================================================

let mapleader="\<space>"

"" ========================================================
"" Options
"" Universal settings work in Vim/Neovim/IdeaVim alike.
"" ========================================================

" --- Universal ---
set scrolloff=10
set history=1000
set number relativenumber
set showmode
set showcmd
set ignorecase          " required for smartcase to actually take effect
set smartcase           " case-insensitive search until an uppercase letter is typed
set incsearch
set hlsearch
set visualbell
set gdefault

" --- IDE-only ---
" 'ideaput' adds native IntelliJ insertion on paste (multi-caret / template aware)
set clipboard+=unnamed,ideaput
set ideajoin
set ideamarks
set idearefactormode=keep
set ideastatusicon=gray
"" ========================================================
"" Plugins (IdeaVim emulations)
"" ========================================================

" General
set exchange
set commentary
set ReplaceWithRegister
set surround
set nerdtree

" Jumping / motions
"  - easymotion (AceJump-backed) is the primary jump engine: <leader><leader>
"  - quickscope passively highlights f/F/t/T targets (no keymaps, pure win)
"  - vim-sneak was REMOVED: it overlapped easymotion and took over `s`/`S`.
"    Want sneak-style `s{char}{char}` back, on one engine? Uncomment:
"        map s <Plug>(easymotion-s2)
set easymotion
let g:EasyMotion_override_acejump = 0
set quickscope
let g:qs_highlight_on_keys = ['f', 'F', 't', 'T']

" Highlighting
set highlightedyank

" Text objects
set textobj-entire
set indent-object
set argtextobj
let g:argtextobj_pairs="[:],(:),<:>"
set functextobj          " am = a method, aM = method incl. comments, im = inner body

" Which-key
set which-key
set notimeout
let g:WhichKey_FontSize = 20
let g:WhichKey_PrefixColor = "#a403fe"
let g:WhichKey_CommandColor = "#01ffff"
let g:WhichKey_PrefixStyle = "bold"
let g:WhichKey_KeyStyle = "italic"
let g:WhichKey_SortOrder = "by_key_prefix_first"
let g:WhichKey_ShowTypedSequence = "false"
"" ========================================================
"" Key mappings (non-leader)
"" ========================================================

" Let IdeaVim win these in normal mode so pane navigation isn't swallowed.
sethandler <C-h> n:vim
sethandler <C-j> n:vim
sethandler <C-k> n:vim
sethandler <C-l> n:vim

" Tab navigation
nmap <C-p> <Action>(PreviousTab)
nmap <C-n> <Action>(NextTab)

" Pane navigation
nnoremap <C-h> <C-w>h
nnoremap <C-l> <C-w>l
nnoremap <C-k> <C-w>k
nnoremap <C-j> <C-w>j

" Jumplist navigation
" NOTE: <C-i> is the SAME keycode as <Tab>. C-o -> Back and C-i (Tab) -> Forward
" matches the native Vim jumplist direction.
nmap <C-o> <Action>(Back)
nmap <C-i> <Action>(Forward)

" Jump between methods
nmap [[ <Action>(MethodUp)
nmap ]] <Action>(MethodDown)

" Visual indentation (keep selection)
vnoremap < <gv
vnoremap > >gv

" LSP-style bare keys
" (gd overrides native go-to-local-declaration; gi overrides native
"  insert-at-last-position. Use `gi`'s native behavior via `` `^ `` if needed.)
nmap K  <Action>(QuickJavaDoc)
nmap gd <Action>(GotoDeclaration)
nmap gi <Action>(GotoImplementation)
nmap gr <Action>(FindUsages)
nmap gy <Action>(GotoTypeDeclaration)

" Multiple cursors (IDE multi-caret)
" Alt mappings can be intercepted by the OS/keymap on some systems; remap if so.
map <A-n> <Action>(SelectNextOccurrence)
map <A-p> <Action>(UnselectPreviousOccurrence)
map <A-a> <Action>(SelectAllOccurrences)

" Semantic expand / shrink selection
map <A-Up>   <Action>(EditorSelectWord)
map <A-Down> <Action>(EditorUnSelectWord)

" Move lines up / down
nnoremap <A-j> <Action>(MoveLineDown)
nnoremap <A-k> <Action>(MoveLineUp)

" Tool windows popup
nmap <C-S-m> <Action>(ToolWindowsGroup)

" Clear search highlighting
" Written as <Esc> on purpose (<C-[> is byte-identical to <Esc>).
" If it ever clashes with which-key popup dismissal, move it to <leader>h.
nnoremap <silent> <Esc> :nohlsearch<CR>
"" ========================================================
"" Leader commands (which-key driven)
"" ========================================================

" EasyMotion (plugin default prefix)
let g:WhichKeyDesc_easymotion = "<leader><leader> EasyMotion"


